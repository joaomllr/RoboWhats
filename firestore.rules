rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // BASE POLICY: Deny all reads and writes by default
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTenantUser(tenantId) {
      return isAuthenticated() && 
        request.auth.token.tenantId == tenantId;
    }

    function isTenantAdmin(tenantId) {
      return isTenantUser(tenantId) && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'owner');
    }

    // -------------------------------------------------------------
    // PROTECTED INTERNAL COLLECTIONS: No direct client access
    // -------------------------------------------------------------
    match /phoneNumberIndex/{phoneNumberId} {
      allow read, write: if false; // Admin SDK only
    }

    // -------------------------------------------------------------
    // TENANT SCOPED DATA ISOLATION: tenants/{tenantId}/**
    // -------------------------------------------------------------
    match /tenants/{tenantId} {
      // Tenant root metadata: only authenticated users belonging to this tenant can read
      allow read: if isTenantUser(tenantId);
      allow write: if isTenantAdmin(tenantId);

      // Bot configuration: persona, state machine, hours
      match /config/{configDoc} {
        allow read: if isTenantUser(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Contacts & Leads
      match /contacts/{contactId} {
        allow read, write: if isTenantUser(tenantId);
      }

      // Conversations & Messages
      match /conversations/{conversationId} {
        allow read, write: if isTenantUser(tenantId);

        match /messages/{messageId} {
          allow read, write: if isTenantUser(tenantId);
        }
      }

      // Usage & Billing Telemetry: Read-only for tenant; writes restricted to Admin SDK
      match /usage/{period} {
        allow read: if isTenantUser(tenantId);
        allow write: if false; // Only Cloud Functions (Admin SDK) increment usage
      }
    }
  }
}
