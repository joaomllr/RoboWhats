# WhatsApp Sales Hub - Environment Variables Template
# Copy this file to .env.local for local emulation/testing only.
# In production, all secrets MUST be stored exclusively in Google Cloud Secret Manager.

# --- Meta WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# --- Google / Gemini API ---
GEMINI_API_KEY=

# --- Firebase Client Config (Public for Dashboard Frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
